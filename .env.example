# Verofax Finance Platform — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...your-publishable-key...

# Service-role key — needed for public leave-submit + manager approval flows.
# Supabase Dashboard → Settings → API → "service_role" secret. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-secret...

# ---- Gmail SMTP (sends leave approval emails) ----
# 1. Pick a Gmail account (e.g. verofax1@gmail.com)
# 2. Enable 2-factor auth on that account
# 3. Generate an App Password at https://myaccount.google.com/apppasswords
#    (Select app: Mail, Device: Other → "Verofax Finance")
# 4. Paste the 16-character password below (spaces don't matter, stripped at runtime)
GMAIL_USER=verofax1@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Verofax Finance

# ---- App URL ----
# Used to build approval links in emails, and by HR Concierge server-side
# code to call this same app's own /api/leave-submit route. Always the URL
# of THIS deployment — never the Supabase URL, never another product's URL.
# Local dev: http://localhost:3000
# HR Concierge production deployment: e.g. https://hr.digitalriseinnovations.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- HR Concierge (Digital Rise AI Employee) ----
# Uses the SAME Supabase project/keys and GMAIL_* vars above — see
# HR_DEPLOYMENT_CHECKLIST.md for the full HR-specific deployment guide.
# Must point at the isolated "HR Concierge Demo" (or a customer's own)
# Supabase project — never a Finance/Verofax production project.

# Deployment-level product identity for the SHARED leave-approval workflow
# (manager email + /leave-decision page) — controls branding only, never
# token security/approve-reject logic/balance deduction, which are
# identical either way. Set to "hr" for an HR Concierge deployment so
# managers see "Digital Rise HR Concierge" instead of "Verofax Finance" in
# that email/page. Leave unset (or any other value) to keep existing
# Verofax Finance behavior — this is the default, so omitting it changes
# nothing for the legacy Finance app.
APP_PRODUCT_MODE=hr

ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key...

# Secret used to sign employee session cookies (two-factor employee_code +
# email identity, separate from Supabase Auth staff login). Generate with:
# openssl rand -base64 32
HR_CONCIERGE_SESSION_SECRET=

# Inbox that receives "escalate to HR" notifications from the Concierge chat.
HR_CONCIERGE_ESCALATION_EMAIL=hr@example.com

# Optional — defaults to Haiku 4.5 if unset.
# HR_CONCIERGE_AI_MODEL=claude-haiku-4-5-20251001
